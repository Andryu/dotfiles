# 自宅マシンだけに入れるもの（仕事マシンでは実行しない）
#   適用: brew bundle --file ~/Workspace/dotfiles/Brewfile.personal
# 共通ツールは Brewfile 側。

# --- コミュニケーション・制作 ---
cask "discord"
cask "canva"

# --- データ分析（alpha-predict-jp 等）---
cask "miniforge"          # conda-forge
brew "libomp"             # LightGBM / XGBoost が要求する OpenMP
brew "ffmpeg"

# --- 趣味 ---
cask "cemu"               # TI-84 Plus CE エミュレータ

# --- フォント比較で入れたもの（PlemolJP に決めたので削除候補）---
cask "font-hackgen"
cask "font-udev-gothic"
cask "font-cica"
cask "font-ricty-diminished"
